{
  "ConnectionStrings": {
    "DefaultConnection": "Server=<SQL_SERVER>;Database=<SQL_DATABASE>;Persist Security Info=True;User ID=<SQL_USER>;Password=<SQL_PASSWORD>;MultipleActiveResultSets=True;Encrypt=True;TrustServerCertificate=False;"
  },

  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "<ENTRA_DOMAIN>",
    "TenantId": "<ENTRA_TENANT_ID>",
    "ClientId": "<ENTRA_CLIENT_ID>",
    "CallbackPath": "/signin-oidc",

    "ClientCredentials": [
      {
        "SourceType": "Path",
        "CertificateDiskPath": "<PATH_TO_ENTRA_CERTIFICATE_PFX>",
        "CertificatePassword": "<ENTRA_CERTIFICATE_PASSWORD>"
      }
    ]
  },

  "GitHub": {
    "AuthenticationMode": "GitHubApp",

    "EnterpriseName": "<GITHUB_ENTERPRISE_NAME>",
    "EnterpriseSlug": "<GITHUB_ENTERPRISE_SLUG>",

    "WebBaseUrl": "https://<GITHUB_WEB_HOST>/",
    "ApiBaseUrl": "https://<GITHUB_API_HOST>/",

    "AppId": "<GITHUB_APP_ID>",
    "InstallationId": "<GITHUB_INSTALLATION_ID>",

    "PrivateKeyPath": "<PATH_TO_GITHUB_APP_PRIVATE_KEY_PEM>",

    "Organization": "<GITHUB_ORGANIZATION>",
    "AllowedOrganization": "<GITHUB_ALLOWED_ORGANIZATION>",

    "ClientId": "<GITHUB_CLIENT_ID>",
    "ClientSecret": "<GITHUB_CLIENT_SECRET>",

    "CallbackUrl": "https://<APP_HOST>/github/callback"
  },

  "Approval": {
    "LifetimeMinutes": 15
  },

  "OAuth": {
    "Issuer": "https://<APP_HOST>/",
    "SigningCertificateThumbprint": "<OAUTH_SIGNING_CERT_THUMBPRINT>",
    "EncryptionCertificateThumbprint": "<OAUTH_ENCRYPTION_CERT_THUMBPRINT>"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Identity.Web": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "AllowedHosts": "<APP_HOST>"
}